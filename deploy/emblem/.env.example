# Copy to /opt/apps/emblem/.env on the droplet and fill in.
# Values must match the gateway's .env so CORS + TLS are coherent.

# Gateway hostname — sslip.io hostname for this droplet.
SITE_ADDRESS=159-203-108-80.sslip.io

# GHCR image coordinates. GH_REPO is "<owner>/<repo>" (must be lowercased).
GH_REPO=yourname/emblem-cards
IMAGE_TAG=latest
